# Robin LLM provider credentials.
# Copy to .env in your Robin checkout: cp .env.example .env
# Robin needs exactly one provider configured; leave the rest blank.

# --- Hosted providers (a model only appears in the UI if its key is set) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- OpenRouter (base URL defaults to https://openrouter.ai/api/v1 if blank) ---
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=

# --- Local inference ---
# Docker:  http://host.docker.internal:11434
# Native:  http://127.0.0.1:11434
OLLAMA_BASE_URL=
LLAMA_CPP_BASE_URL=

# --- Any other OpenAI-compatible endpoint (LM Studio, Groq, vLLM, ...) ---
# Can also be set at runtime from the "Custom API Provider" sidebar expander.
# CUSTOM_API_MODEL is only needed when the provider does not expose /v1/models.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=
